{
  "name": "yuanyuan-reminder",
  "private": true,
  "version": "1.3.0",
  "description": "Offline Windows desktop pet for reminders, focus, hydration and breaks.",
  "license": "MIT",
  "homepage": "https://github.com/brucexia007-ui/yuanyuan-reminder",
  "repository": {
    "type": "git",
    "url": "https://github.com/brucexia007-ui/yuanyuan-reminder.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
