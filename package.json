  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
