    "check": "tsc -b --pretty false && vitest run",
    "pet:validate": "node scripts/validate_pet_pack.mjs",
    "verify": "npm run check && npm run pet:validate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
